# Copy this file to .env in the repo root and replace the placeholders.
# Never commit .env.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# OpenWeather (used only by the backend)
OPENWEATHER_API_KEY=replace-with-your-openweather-api-key
OPENWEATHER_TIMEOUT_SECONDS=5
